# Optionaler systemd-Benutzerdienst; Pfad bei anderem Checkout anpassen.
# Nur Beispiel: wird nicht automatisch installiert oder aktiviert.
[Unit]
Description=LiveScore – lokale Spielstandserfassung
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/LiveScore
ExecStart=%h/LiveScore/.venv/bin/python -m livescore --config %h/LiveScore/config/livescore.yml
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
