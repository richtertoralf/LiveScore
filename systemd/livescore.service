# Managed by the LiveScore installer; operator overrides: systemctl edit livescore.
[Unit]
Description=LiveScore
After=network.target

[Service]
Type=simple
User=livescore
Group=livescore
WorkingDirectory=/opt/livescore/current
ExecStart=/opt/livescore/current/bin/livescore
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/livescore /var/lib/livescore

[Install]
WantedBy=multi-user.target
